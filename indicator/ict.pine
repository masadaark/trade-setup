//@version=6
// ICT Advanced Framework — Deep Inner Circle Trader Methodology
indicator(title="ICT Advanced Framework", shorttitle="ICT Framework", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =========================================================================
// 1. SETTINGS & INPUTS
// =========================================================================
color TRANSP_CSS = #ffffff00

group_time    = "Time, Killzones & Macros"
tz_input      = input.string("America/New_York", "Timezone", group=group_time, tooltip="ICT concepts are strictly based on NY local time.")

show_kz       = input(true, "Show Killzones", group=group_time)
asian_time    = input.session("2000-0000", "Asian Range (Accumulation)", group=group_time)
london_time   = input.session("0200-0500", "London Open (Judas Swing)", group=group_time)
ny_am_time    = input.session("0830-1100", "New York AM Open", group=group_time)
ny_pm_time    = input.session("1330-1600", "New York PM Open", group=group_time)
asian_css     = input.color(color.new(#2196f3, 93), "Asian Color", group=group_time)
london_css    = input.color(color.new(#ff9800, 93), "London Color", group=group_time)
ny_am_css     = input.color(color.new(#f44336, 93), "NY AM Color", group=group_time)
ny_pm_css     = input.color(color.new(#9c27b0, 93), "NY PM Color", group=group_time)

show_sb       = input(true, "Show Silver Bullet Macros", group=group_time)
sb_london_time= input.session("0300-0400", "London Silver Bullet", group=group_time)
sb_am_time    = input.session("1000-1100", "AM Silver Bullet", group=group_time)
sb_pm_time    = input.session("1400-1500", "PM Silver Bullet", group=group_time)
sb_css        = input.color(color.new(#ffffff, 85), "Silver Bullet Color", group=group_time)

show_amd_proj = input(true, "Show Asian Range Projections (AMD)", group=group_time)

show_open_lines = input(true, "Show NWOG / NDOG / 8:30", group=group_time)

group_struct  = "Market Structure & Liquidity"
length        = input.int(10, "Swing Length", minval=2, group=group_struct)
show_swings   = input(true, "Show Swings", group=group_struct)
show_bos_mss  = input(true, "Show BOS / MSS", group=group_struct)
req_disp      = input(true, "Require Displacement (FVG) for MSS", group=group_struct)
bull_css      = input.color(#00e676, "Bull Structure Color", group=group_struct)
bear_css      = input.color(#ff5252, "Bear Structure Color", group=group_struct)
lbl_size      = size.small

show_liq      = input(true, "Show Liquidity (BSL/SSL)", group=group_struct)
show_eqhl     = input(true, "Show EQH/EQL (Retail Liquidity)", group=group_struct)
eqhl_thresh   = input.float(0.1, "EQH/EQL Threshold (ATR)", minval=0.01, step=0.05, group=group_struct)

group_pd      = "PD Arrays (FVG, VI, OB, Breakers)"
show_fvg      = input(true, "Show FVG (BISI/SIBI)", group=group_pd)
bisi_css      = input.color(color.new(#00e676, 75), "BISI (Bull FVG)", group=group_pd)
sibi_css      = input.color(color.new(#ff5252, 75), "SIBI (Bear FVG)", group=group_pd)
show_ifvg     = input(true, "Show Inversion FVG", group=group_pd)
ifvg_css      = input.color(color.new(#ffeb3b, 75), "Inversion FVG", group=group_pd)

show_vi       = input(true, "Show Volume Imbalance (VI)", group=group_pd)
vi_css        = input.color(color.new(#2962ff, 60), "Volume Imbalance Color", group=group_pd)

show_ob       = input(true, "Show Order Blocks", group=group_pd)
bull_ob_css   = input.color(color.new(#1848cc, 85), "Bull OB", group=group_pd)
bear_ob_css   = input.color(color.new(#b22833, 85), "Bear OB", group=group_pd)
show_breaker  = input(true, "Show Breaker Blocks", group=group_pd)
bull_brk_css  = input.color(color.new(#00bcd4, 75), "Bullish Breaker", group=group_pd)
bear_brk_css  = input.color(color.new(#ff9800, 75), "Bearish Breaker", group=group_pd)

group_ote     = "Dealing Range & OTE"
show_ote      = input(true, "Show Dealing Range (Premium/Discount)", group=group_ote)
ote_css       = input.color(#b2b5be, "OTE Fib Color", group=group_ote)
shade_pd      = input(true, "Shade Premium / Discount Zones", group=group_ote)

group_entry   = "ICT 2022 Mentorship Entry Model"
use_ict22     = input(true, "Enable Entry Model Signals", group=group_entry, tooltip="Sweep -> MSS + Disp -> FVG -> Entry in KZ/Macro")
cooldown      = input.int(5, "Signal Cooldown (bars)", group=group_entry)

group_quant   = "Quantitative Overlay (EMA & Z-Score)"
show_quant    = input(true, "Show Quantitative Overlay", group=group_quant)
ema_len       = input.int(200, "EMA Length", group=group_quant)
z_len         = input.int(200, "Z-Score Length", group=group_quant)
z_k           = input.float(2.0, "Z-Score Multiplier", group=group_quant)

// =========================================================================
// 2. TIMEZONES, MACROS & OPENING GAPS
// =========================================================================
n = bar_index
atr = ta.atr(200)

f_in_session(sess) => not na(time(timeframe.period, sess, tz_input))

is_asian  = f_in_session(asian_time)
is_london = f_in_session(london_time)
is_ny_am  = f_in_session(ny_am_time)
is_ny_pm  = f_in_session(ny_pm_time)

sb_london = f_in_session(sb_london_time)
sb_am     = f_in_session(sb_am_time)
sb_pm     = f_in_session(sb_pm_time)

bgcolor(show_kz and is_asian ? asian_css : na, title="Asian Range")
bgcolor(show_kz and is_london ? london_css : na, title="London Killzone")
bgcolor(show_kz and is_ny_am ? ny_am_css : na, title="NY AM Killzone")
bgcolor(show_kz and is_ny_pm ? ny_pm_css : na, title="NY PM Killzone")

bgcolor(show_sb and sb_london ? sb_css : na, title="SB London")
bgcolor(show_sb and sb_am ? sb_css : na, title="SB AM")
bgcolor(show_sb and sb_pm ? sb_css : na, title="SB PM")

// Opening Gaps (NDOG, NWOG, 8:30)
var float ndog_open = na
var float am830_open = na
var float nwog_open = na
var line ndog_line  = na
var line am830_line = na
var line nwog_line  = na

is_new_day = ta.change(time("D", tz_input)) != 0
is_new_week = ta.change(time("W", tz_input)) != 0
is_new_830 = not na(time(timeframe.period, "0830-0831", tz_input)) and na(time(timeframe.period, "0830-0831", tz_input)[1])

if is_new_week
    nwog_open := open
if is_new_day
    ndog_open := open
if is_new_830
    am830_open := open

if show_open_lines
    if is_new_week
        nwog_line := line.new(n, nwog_open, n, nwog_open, color=color.purple, style=line.style_dashed, width=2)
        label.new(n, nwog_open, "NWOG", color=TRANSP_CSS, textcolor=color.purple, style=label.style_label_left, size=size.tiny)
    else if not na(nwog_line)
        line.set_x2(nwog_line, n)
        
    if is_new_day
        ndog_line := line.new(n, ndog_open, n, ndog_open, color=color.white, style=line.style_dotted)
        label.new(n, ndog_open, "NDOG", color=TRANSP_CSS, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    else if not na(ndog_line)
        line.set_x2(ndog_line, n)

    if is_new_830
        am830_line := line.new(n, am830_open, n, am830_open, color=color.yellow, style=line.style_dotted)
        label.new(n, am830_open, "8:30 AM", color=TRANSP_CSS, textcolor=color.yellow, style=label.style_label_left, size=size.tiny)
    else if not na(am830_line)
        line.set_x2(am830_line, n)

// Asian Range Projections (AMD)
var float asian_high = na
var float asian_low = na
var line ar_h_line = na
var line ar_l_line = na
var line[] amd_lines = array.new_line(0)

if is_asian
    if not is_asian[1] // Session start
        asian_high := high
        asian_low := low
        if show_amd_proj
            for l in amd_lines
                line.delete(l)
            array.clear(amd_lines)
            ar_h_line := line.new(n, asian_high, n, asian_high, color=color.gray)
            ar_l_line := line.new(n, asian_low, n, asian_low, color=color.gray)
    else // Inside session
        asian_high := math.max(asian_high, high)
        asian_low := math.min(asian_low, low)
        if show_amd_proj
            line.set_y1(ar_h_line, asian_high)
            line.set_y2(ar_h_line, asian_high)
            line.set_x2(ar_h_line, n)
            line.set_y1(ar_l_line, asian_low)
            line.set_y2(ar_l_line, asian_low)
            line.set_x2(ar_l_line, n)
else if is_asian[1] and show_amd_proj // Session end, project SDs
    float ar_range = asian_high - asian_low
    if ar_range > 0
        // Project 1.5, 2.0, 2.5
        float t_up1 = asian_high + ar_range * 1.5
        float t_up2 = asian_high + ar_range * 2.0
        float t_up3 = asian_high + ar_range * 2.5
        float t_dn1 = asian_low - ar_range * 1.5
        float t_dn2 = asian_low - ar_range * 2.0
        float t_dn3 = asian_low - ar_range * 2.5
        
        array.push(amd_lines, line.new(n, t_up1, n + 50, t_up1, color=color.new(bull_css, 50), style=line.style_dotted))
        array.push(amd_lines, line.new(n, t_up2, n + 50, t_up2, color=color.new(bull_css, 50), style=line.style_dotted))
        array.push(amd_lines, line.new(n, t_up3, n + 50, t_up3, color=color.new(bull_css, 50), style=line.style_dotted))
        
        array.push(amd_lines, line.new(n, t_dn1, n + 50, t_dn1, color=color.new(bear_css, 50), style=line.style_dotted))
        array.push(amd_lines, line.new(n, t_dn2, n + 50, t_dn2, color=color.new(bear_css, 50), style=line.style_dotted))
        array.push(amd_lines, line.new(n, t_dn3, n + 50, t_dn3, color=color.new(bear_css, 50), style=line.style_dotted))

// =========================================================================
// 3. MARKET STRUCTURE & LIQUIDITY (Swings, MSS, Purge)
// =========================================================================
swings(len) =>
    var int os = 0
    upper = ta.highest(len)
    lower = ta.lowest(len)
    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]
    top = os == 0 and os[1] != 0 ? high[len] : 0
    btm = os == 1 and os[1] != 1 ? low[len] : 0
    [top, btm]

[top, btm] = swings(length)

var trend = 0
var float top_y = 0.
var int top_x = 0
var float btm_y = 0.
var int btm_x = 0
var float trail_up = high
var float trail_dn = low
var int trail_up_x = 0
var int trail_dn_x = 0
var bool top_cross = true
var bool btm_cross = true

var bool bsl_swept = false
var bool ssl_swept = false

var ob_top = array.new_float(0)
var ob_btm = array.new_float(0)
var ob_left = array.new_int(0)
var ob_type = array.new_int(0) 
var ob_swept = array.new_bool(0) 

var brk_top = array.new_float(0)
var brk_btm = array.new_float(0)
var brk_left = array.new_int(0)
var brk_type = array.new_int(0) 

prev_trail_up = trail_up
prev_trail_dn = trail_dn

// FVG Helpers for Displacement Check
f_bisi_formed() => low > high[2] and close[1] > open[1] // Displacement candle must be bullish
f_sibi_formed() => high < low[2] and close[1] < open[1] // Displacement candle must be bearish

// State tracking for MSS
var float last_mss_time = 0
var int mss_dir = 0

ob_coord(is_bear, loc) =>
    // loc is the bar index of the origin pivot (btm_x for Bull OB, top_x for Bear OB)
    float ob_t = na
    float ob_b = na
    int ob_idx = 1
    found = false
    // Search starting exactly at the pivot, and go backwards in time up to 5 bars
    for i = (n - loc) to (n - loc) + 5
        if is_bear // Bearish OB (last up-close candle)
            if close[i] > open[i]
                ob_t := math.max(open[i], close[i])
                ob_b := math.min(open[i], close[i])
                ob_idx := i
                found := true
                break
        else // Bullish OB (last down-close candle)
            if close[i] < open[i]
                ob_t := math.max(open[i], close[i])
                ob_b := math.min(open[i], close[i])
                ob_idx := i
                found := true
                break
    if found
        array.unshift(ob_top, ob_t)
        array.unshift(ob_btm, ob_b)
        array.unshift(ob_left, n - ob_idx)
        array.unshift(ob_type, is_bear ? -1 : 1)
        array.unshift(ob_swept, is_bear ? bsl_swept : ssl_swept)

// Pivot High
if top > 0
    top_cross := true
    bsl_swept := false
    if show_swings
        label.new(n-length, top, "HH", color=TRANSP_CSS, textcolor=bear_css, style=label.style_label_down, size=size.tiny)
    top_y := top
    top_x := n - length
    trail_up := top
    trail_up_x := n - length

trail_up := math.max(high, trail_up)
trail_up_x := trail_up == high ? n : trail_up_x

// BSL Purge (Judas Swing)
bsl_sweep_raw = prev_trail_up > 0 and (high > prev_trail_up and close <= prev_trail_up)
if bsl_sweep_raw
    bsl_swept := true
    if show_liq
        label.new(n, high + atr*0.1, "BSL Purge", color=TRANSP_CSS, textcolor=#ff5252, style=label.style_label_down, size=size.tiny)

// Pivot Low
if btm > 0
    btm_cross := true
    ssl_swept := false
    if show_swings
        label.new(n-length, btm, "LL", color=TRANSP_CSS, textcolor=bull_css, style=label.style_label_up, size=size.tiny)
    btm_y := btm
    btm_x := n - length
    trail_dn := btm
    trail_dn_x := n - length

trail_dn := math.min(low, trail_dn)
trail_dn_x := trail_dn == low ? n : trail_dn_x

// SSL Purge (Judas Swing)
ssl_sweep_raw = prev_trail_dn > 0 and (low < prev_trail_dn and close >= prev_trail_dn)
if ssl_sweep_raw
    ssl_swept := true
    if show_liq
        label.new(n, low - atr*0.1, "SSL Purge", color=TRANSP_CSS, textcolor=#00e676, style=label.style_label_up, size=size.tiny)

// EQH / EQL detection (Retail Liquidity)
var float last_eqh = na
var int eqh_x = 0
var float last_eql = na
var int eql_x = 0

if show_eqhl
    eq_top = ta.pivothigh(3, 3)
    eq_btm = ta.pivotlow(3, 3)
    if not na(eq_top)
        if not na(last_eqh) and math.abs(eq_top - last_eqh) < atr * eqhl_thresh
            line.new(eqh_x, last_eqh, n-3, eq_top, color=bear_css, style=line.style_dotted)
            label.new(n-3, eq_top, "EQH (DOL)", color=TRANSP_CSS, textcolor=bear_css, style=label.style_label_down, size=size.tiny)
        last_eqh := eq_top
        eqh_x := n-3
    if not na(eq_btm)
        if not na(last_eql) and math.abs(eq_btm - last_eql) < atr * eqhl_thresh
            line.new(eql_x, last_eql, n-3, eq_btm, color=bull_css, style=line.style_dotted)
            label.new(n-3, eq_btm, "EQL (DOL)", color=TRANSP_CSS, textcolor=bull_css, style=label.style_label_up, size=size.tiny)
        last_eql := eq_btm
        eql_x := n-3

// FVG (Fair Value Gaps) / Imbalances (Declared here for Displacement check)
var fvg_top = array.new_float(0)
var fvg_btm = array.new_float(0)
var fvg_left = array.new_int(0)
var fvg_type = array.new_int(0) 
var fvg_boxes = array.new_box(0)
var fvg_lines = array.new_line(0)

// Structure Break Triggers
if ta.crossover(close, top_y) and top_cross
    bool has_disp = false
    if array.size(fvg_type) > 0
        for i = 0 to array.size(fvg_type) - 1
            if array.get(fvg_type, i) == 1 and array.get(fvg_left, i) >= btm_x
                has_disp := true
                break
                
    if not req_disp or has_disp
        if trend < 0 // MSS
            if show_bos_mss
                line.new(top_x, top_y, n, top_y, color=bull_css, style=line.style_dashed)
                label.new(int(math.avg(top_x, n)), top_y, "MSS", color=TRANSP_CSS, textcolor=bull_css, style=label.style_label_down, size=lbl_size)
            last_mss_time := time
            mss_dir := 1
            trend := 1
        else if show_bos_mss // Normal BOS
            line.new(top_x, top_y, n, top_y, color=bull_css, style=line.style_dashed)
            label.new(int(math.avg(top_x, n)), top_y, "BOS", color=TRANSP_CSS, textcolor=bull_css, style=label.style_label_down, size=lbl_size)
            trend := 1
        ob_coord(false, btm_x) 
        top_cross := false

if ta.crossunder(close, btm_y) and btm_cross
    bool has_disp = false
    if array.size(fvg_type) > 0
        for i = 0 to array.size(fvg_type) - 1
            if array.get(fvg_type, i) == -1 and array.get(fvg_left, i) >= top_x
                has_disp := true
                break
                
    if not req_disp or has_disp
        if trend > 0 // MSS
            if show_bos_mss
                line.new(btm_x, btm_y, n, btm_y, color=bear_css, style=line.style_dashed)
                label.new(int(math.avg(btm_x, n)), btm_y, "MSS", color=TRANSP_CSS, textcolor=bear_css, style=label.style_label_up, size=lbl_size)
            last_mss_time := time
            mss_dir := -1
            trend := -1
        else if show_bos_mss // Normal BOS
            line.new(btm_x, btm_y, n, btm_y, color=bear_css, style=line.style_dashed)
            label.new(int(math.avg(btm_x, n)), btm_y, "BOS", color=TRANSP_CSS, textcolor=bear_css, style=label.style_label_up, size=lbl_size)
            trend := -1
        ob_coord(true, top_x) 
        btm_cross := false

// =========================================================================
// 4. PD ARRAYS (FVG/VI, Breakers, Order Blocks, OTE)
// =========================================================================

// Volume Imbalance (VI)
// Gap between candle bodies
bull_vi = math.min(open, close) > math.max(open[1], close[1])
bear_vi = math.max(open, close) < math.min(open[1], close[1])

if show_vi
    if bull_vi
        box.new(n-1, math.min(open[1], close[1]), n, math.max(open, close), border_color=vi_css, bgcolor=vi_css)
    if bear_vi
        box.new(n-1, math.max(open[1], close[1]), n, math.min(open, close), border_color=vi_css, bgcolor=vi_css)

if show_fvg
    if f_bisi_formed()
        array.unshift(fvg_top, low)
        array.unshift(fvg_btm, high[2])
        array.unshift(fvg_left, n-1)
        array.unshift(fvg_type, 1)
        bx = box.new(n-2, low, n, high[2], border_color=bisi_css, bgcolor=color.new(bisi_css, 85))
        array.unshift(fvg_boxes, bx)
        ln = line.new(n-2, math.avg(low, high[2]), n, math.avg(low, high[2]), color=bisi_css, style=line.style_dotted)
        array.unshift(fvg_lines, ln)
        
    if f_sibi_formed()
        array.unshift(fvg_top, low[2])
        array.unshift(fvg_btm, high)
        array.unshift(fvg_left, n-1)
        array.unshift(fvg_type, -1)
        bx = box.new(n-2, low[2], n, high, border_color=sibi_css, bgcolor=color.new(sibi_css, 85))
        array.unshift(fvg_boxes, bx)
        ln = line.new(n-2, math.avg(low[2], high), n, math.avg(low[2], high), color=sibi_css, style=line.style_dotted)
        array.unshift(fvg_lines, ln)

// FVG Mitigation and Inversion Logic
if array.size(fvg_type) > 0
    for i = array.size(fvg_type) - 1 to 0
        typ = array.get(fvg_type, i)
        ftop = array.get(fvg_top, i)
        fbtm = array.get(fvg_btm, i)
        bx = array.get(fvg_boxes, i)
        ln = array.get(fvg_lines, i)
        box.set_right(bx, n)
        line.set_x2(ln, n)
        
        bool delete_fvg = false
        
        if typ == 1 // Bull FVG
            if close < fbtm // Inverted
                if show_ifvg
                    array.set(fvg_type, i, 2) // Mark as Bullish IFVG
                    box.set_border_color(bx, ifvg_css)
                    box.set_bgcolor(bx, color.new(ifvg_css, 85))
                    line.set_color(ln, ifvg_css)
                else
                    delete_fvg := true
        else if typ == -1 // Bear FVG
            if close > ftop // Inverted
                if show_ifvg
                    array.set(fvg_type, i, -2) // Mark as Bearish IFVG
                    box.set_border_color(bx, ifvg_css)
                    box.set_bgcolor(bx, color.new(ifvg_css, 85))
                    line.set_color(ln, ifvg_css)
                else
                    delete_fvg := true
        else if typ == 2 // Bullish IFVG (Acts as Resistance)
            if close > ftop // Mitigated Resistance
                delete_fvg := true
        else if typ == -2 // Bearish IFVG (Acts as Support)
            if close < fbtm // Mitigated Support
                delete_fvg := true
                
        if delete_fvg
            box.delete(bx)
            line.delete(ln)
            array.remove(fvg_top, i)
            array.remove(fvg_btm, i)
            array.remove(fvg_left, i)
            array.remove(fvg_type, i)
            array.remove(fvg_boxes, i)
            array.remove(fvg_lines, i)

if array.size(fvg_type) > 15
    array.pop(fvg_top)
    array.pop(fvg_btm)
    array.pop(fvg_left)
    array.pop(fvg_type)
    box.delete(array.pop(fvg_boxes))
    line.delete(array.pop(fvg_lines))

// Order Blocks & Breakers Mitigation
var brk_boxes = array.new_box(0)
var brk_lines = array.new_line(0)

if array.size(ob_type) > 0
    for i = array.size(ob_type) - 1 to 0
        typ = array.get(ob_type, i)
        swept = array.get(ob_swept, i)
        top_lvl = array.get(ob_top, i)
        btm_lvl = array.get(ob_btm, i)
        
        bool invalid = false
        bool convert_to_breaker = false
        
        if typ == 1 // Bull OB
            if close < btm_lvl // Broken down
                invalid := true
                if bsl_swept // If BSL was swept recently, this failed Bull OB becomes a Bearish Breaker
                    convert_to_breaker := true
        else if typ == -1 // Bear OB
            if close > top_lvl // Broken up
                invalid := true
                if ssl_swept // If SSL was swept recently, this failed Bear OB becomes a Bullish Breaker
                    convert_to_breaker := true
                    
        if convert_to_breaker and show_breaker
            array.unshift(brk_top, top_lvl)
            array.unshift(brk_btm, btm_lvl)
            array.unshift(brk_left, array.get(ob_left, i))
            array.unshift(brk_type, typ == 1 ? -1 : 1) 
            bx = box.new(array.get(ob_left, i), top_lvl, n, btm_lvl, border_color=typ == 1 ? bear_brk_css : bull_brk_css, bgcolor=color.new(typ == 1 ? bear_brk_css : bull_brk_css, 85))
            array.unshift(brk_boxes, bx)
            ln = line.new(array.get(ob_left, i), math.avg(top_lvl, btm_lvl), n, math.avg(top_lvl, btm_lvl), color=typ == 1 ? bear_brk_css : bull_brk_css, style=line.style_dotted)
            array.unshift(brk_lines, ln)
            
        if invalid
            array.remove(ob_top, i)
            array.remove(ob_btm, i)
            array.remove(ob_left, i)
            array.remove(ob_type, i)
            array.remove(ob_swept, i)

if show_ob and barstate.islast
    for i = 0 to math.min(array.size(ob_type)-1, 4)
        typ = array.get(ob_type, i)
        lft = array.get(ob_left, i)
        t = array.get(ob_top, i)
        b = array.get(ob_btm, i)
        css = typ == 1 ? bull_ob_css : bear_ob_css
        box.new(lft, t, n, b, border_color=css, bgcolor=color.new(css, 85))
        line.new(lft, math.avg(t, b), n, math.avg(t, b), color=css, style=line.style_dotted)

if array.size(brk_type) > 0
    for i = array.size(brk_type) - 1 to 0
        bx = array.get(brk_boxes, i)
        ln = array.get(brk_lines, i)
        box.set_right(bx, n)
        line.set_x2(ln, n)
        typ = array.get(brk_type, i)
        top_lvl = array.get(brk_top, i)
        btm_lvl = array.get(brk_btm, i)
        if (typ == 1 and close < btm_lvl) or (typ == -1 and close > top_lvl)
            box.delete(bx)
            line.delete(ln)
            array.remove(brk_top, i)
            array.remove(brk_btm, i)
            array.remove(brk_left, i)
            array.remove(brk_type, i)
            array.remove(brk_boxes, i)
            array.remove(brk_lines, i)

if array.size(brk_type) > 10
    array.pop(brk_top)
    array.pop(brk_btm)
    array.pop(brk_left)
    array.pop(brk_type)
    box.delete(array.pop(brk_boxes))
    line.delete(array.pop(brk_lines))

// Dealing Range & OTE
var line ote_1 = na
var line ote_618 = na
var line ote_705 = na
var line ote_79 = na
var line ote_0 = na
var box prem_box = na
var box disc_box = na

if show_ote and barstate.islast
    range_dist = trail_up - trail_dn
    if range_dist > atr
        fib_0 = trend == 1 ? trail_up : trail_dn
        fib_1 = trend == 1 ? trail_dn : trail_up
        f500 = fib_1 + (fib_0 - fib_1) * 0.500
        f618 = fib_1 + (fib_0 - fib_1) * 0.382 
        f705 = fib_1 + (fib_0 - fib_1) * 0.295 
        f790 = fib_1 + (fib_0 - fib_1) * 0.210 
        
        origin_x = trend == 1 ? trail_dn_x : trail_up_x
        
        if na(ote_1)
            ote_1 := line.new(origin_x, fib_1, n, fib_1, color=ote_css, style=line.style_dashed)
            ote_618 := line.new(origin_x, f618, n, f618, color=color.new(#ff9800, 30), style=line.style_solid, width=2)
            ote_705 := line.new(origin_x, f705, n, f705, color=color.new(#ff5252, 30), style=line.style_solid, width=2)
            ote_79 := line.new(origin_x, f790, n, f790, color=color.new(#00e676, 30), style=line.style_solid, width=2)
            ote_0 := line.new(origin_x, fib_0, n, fib_0, color=ote_css, style=line.style_dashed)
            if shade_pd
                prem_box := box.new(origin_x, trail_up, n, f500, bgcolor=color.new(#ff5252, 95), border_color=TRANSP_CSS)
                disc_box := box.new(origin_x, f500, n, trail_dn, bgcolor=color.new(#00e676, 95), border_color=TRANSP_CSS)
        else
            line.set_xy1(ote_1, origin_x, fib_1)
            line.set_xy2(ote_1, n, fib_1)
            line.set_xy1(ote_618, origin_x, f618)
            line.set_xy2(ote_618, n, f618)
            line.set_xy1(ote_705, origin_x, f705)
            line.set_xy2(ote_705, n, f705)
            line.set_xy1(ote_79, origin_x, f790)
            line.set_xy2(ote_79, n, f790)
            line.set_xy1(ote_0, origin_x, fib_0)
            line.set_xy2(ote_0, n, fib_0)
            if shade_pd
                box.set_lefttop(prem_box, origin_x, trail_up)
                box.set_rightbottom(prem_box, n, f500)
                box.set_lefttop(disc_box, origin_x, f500)
                box.set_rightbottom(disc_box, n, trail_dn)

// =========================================================================
// 5. ICT 2022 MENTORSHIP ENTRY MODEL
// =========================================================================
var int last_bull_entry = 0
var int last_bear_entry = 0

in_macro = is_asian or is_london or is_ny_am or is_ny_pm or sb_london or sb_am or sb_pm

in_bisi = false
in_sibi = false
if array.size(fvg_type) > 0
    for i = 0 to array.size(fvg_type) - 1
        if array.get(fvg_type, i) == 1 and low <= array.get(fvg_top, i) and close >= array.get(fvg_btm, i)
            in_bisi := true
        if array.get(fvg_type, i) == -1 and high >= array.get(fvg_btm, i) and close <= array.get(fvg_top, i)
            in_sibi := true

bull_ict22 = use_ict22 and in_macro and ssl_swept and mss_dir == 1 and in_bisi and (n - last_bull_entry) > cooldown
if bull_ict22
    last_bull_entry := n
    label.new(n, low - atr*0.2, "ICT'22\nLONG", color=TRANSP_CSS, textcolor=#00e676, style=label.style_label_up, size=size.small)

bear_ict22 = use_ict22 and in_macro and bsl_swept and mss_dir == -1 and in_sibi and (n - last_bear_entry) > cooldown
if bear_ict22
    last_bear_entry := n
    label.new(n, high + atr*0.2, "ICT'22\nSHORT", color=TRANSP_CSS, textcolor=#ff5252, style=label.style_label_down, size=size.small)

// =========================================================================
// 6. QUANTITATIVE OVERLAY (EMA 200 & Z-SCORE BANDS)
// =========================================================================
ema_val = ta.ema(close, ema_len)
stdev_val = ta.stdev(close, z_len)
upper_band = ema_val + z_k * stdev_val
lower_band = ema_val - z_k * stdev_val

plot(show_quant ? ema_val : na, title="EMA", color=color.new(color.white, 70), linewidth=1)
p_hi = plot(show_quant ? upper_band : na, title="+Sigma Band", color=color.new(color.white, 80), linewidth=1)
p_lo = plot(show_quant ? lower_band : na, title="-Sigma Band", color=color.new(color.white, 80), linewidth=1)
fill(p_hi, p_lo, color=show_quant ? color.new(color.white, 97) : na, title="Sigma Band Fill")

// Alerts
alertcondition(bull_ict22, "ICT 2022 Long Entry", "ICT 2022 Setup: Long Entry Triggered")
alertcondition(bear_ict22, "ICT 2022 Short Entry", "ICT 2022 Setup: Short Entry Triggered")
alertcondition(bsl_sweep_raw, "BSL Sweep", "Buy Side Liquidity Purged")
alertcondition(ssl_sweep_raw, "SSL Sweep", "Sell Side Liquidity Purged")
