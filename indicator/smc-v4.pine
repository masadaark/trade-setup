//@version=6
// Mazada SMC v4 — Mastery Framework (aligned with brain/trade-setup.md)
// v4 focus: HTF alignment, CID vs CHoCH, liquidity sweeps, Strong H/L after sweep,
// Fail Swing, AMD phases, 1-2-3 Entry confirm, XAU-adaptive SL, 80/20 sideway filter
indicator(title = "Mazada SMC v4 — Mastery Framework", shorttitle = "Mazada v4", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =========================================================================
// 1. EMA & SIGMA BANDS CALCULATIONS & PLOTS
// =========================================================================
emaLen       = 200
fastLen      = 20
slowLen      = 50
maxEmaGap    = 0.01  // 1% default

ema200   = ta.ema(close, emaLen)
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.sma(close, slowLen)
hh = ta.highest(close, 50)

ema200Slope = (ema200 - ema200[40]) / ema200[40]
isUptrend   = ema200Slope > 0 and emaFast > ema200
isDowntrend = ema200Slope < 0 and emaFast < ema200
low20 = ta.lowest(low, 20)
priceInBuyerZone = close <= low20

// === EMA Gap Filter ===
emaGap = emaFast - emaSlow

// =========================================================================
// 1A. TREND ACCELERATION (2nd Derivative / Finite Difference)
// Report.txt §1: "Trend Velocity" = First Derivative (Slope)
// Report.txt §3: "Slope Analysis" = Chain Rule for CHoCH early detection
// Implementation: Forward Difference d²P/dt² ≈ Slope(t) - Slope(t-1)
// =========================================================================
ema200Accel = ta.change(ema200Slope)  // 2nd derivative: acceleration of EMA200 trend

// Classify momentum state: Accelerating, Decelerating, or Neutral
string momentum_state = ema200Accel > 0 and ema200Slope > 0 ? "⬆ Accel" : ema200Accel < 0 and ema200Slope < 0 ? "⬇ Accel" : ema200Accel > 0 and ema200Slope < 0 ? "⬆ Decel" : ema200Accel < 0 and ema200Slope > 0 ? "⬇ Decel" : "Neutral"

// Early CHoCH Warning: slope still negative but acceleration turned positive
early_choch_bull = ema200Slope < 0 and ema200Accel > 0
early_choch_bear = ema200Slope > 0 and ema200Accel < 0

// === Sigma Bands around EMA200 ===
zLen   = 200
zK     = 2.0
stdev  = ta.stdev(close, zLen)
upperBand = ema200 + zK * stdev
lowerBand = ema200 - zK * stdev

// =========================================================================
// 1B. VOLATILITY STATE DETECTION (σ Expansion/Contraction)
// Report.txt §4: "Volatility Expansion" via Implied Volatility / Kurtosis
// Implementation: Compare current σ against its own moving average
// =========================================================================
stdev_avg = ta.sma(stdev, 50)          // Mean volatility over 50 bars
vol_ratio = stdev / stdev_avg           // Ratio: >1 = expanding, <1 = contracting
vol_expanding   = vol_ratio > 1.3       // Significant expansion threshold
vol_contracting = vol_ratio < 0.7       // Significant contraction threshold

// Sigma Band touch alerts
price_at_upper = high >= upperBand
price_at_lower = low <= lowerBand

// =========================================================================
// 1C. TAYLOR-PROJECTED PRICE LINE (Finite Difference Approximation)
// Report.txt §5: Taylor Series P(x+h) ≈ P(x) + hP'(x) + (h²/2)P''(x)
// Report.txt §5: Forward/Central Finite Differences for discrete data
// Implementation: 2nd-order Taylor expansion using bar-by-bar differences
// =========================================================================
// First derivative (Forward Difference): P'(x) ≈ P(x) - P(x-1)
price_d1 = close - close[1]
// Second derivative (Central Difference): P''(x) ≈ P(x) - 2P(x-1) + P(x-2)
price_d2 = close - 2 * close[1] + close[2]
// Taylor projection for next bar: P(x+1) ≈ P(x) + P'(x) + P''(x)/2
taylor_proj = close + price_d1 + price_d2 / 2
// Smoothed projection to reduce noise (EMA of raw projection)
taylor_smooth = ta.ema(taylor_proj, 5)

// ==== Plot EMAs and Bands (minimal plot budget — SMC & trend priority) ====
plot(ema200, title="EMA200", color=color.new(color.white, 0), linewidth=2)
p_sigma_hi = plot(upperBand, title="+2σ Band", color=color.new(color.white, 50), linewidth=1)
p_sigma_lo = plot(lowerBand, title="-2σ Band", color=color.new(color.white, 50), linewidth=1)
fill(p_sigma_hi, p_sigma_lo, color=color.new(color.white, 97), title="σ Band Fill")

// Early CHoCH hint via table only (bgcolor removed — saves 1 plot count)

// (Trend acceleration arrow/label plots removed as requested)

// (Buy/Sell signal engine and plotshapes removed as requested)


