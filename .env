# Backend / Internal API Config (ถ้ามี Backend ของตัวเอง)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# 3rd Party Data Sources & API Keys
# 1. FRED (Federal Reserve Economic Data) - สมัครฟรีที่ https://fred.stlouisfed.org/docs/api/api_key.html
VITE_FRED_API_KEY=your_fred_api_key_here

# 2. Alpha Vantage (Fallback สำหรับ Forex/Commodity) - สมัครฟรีที่ https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# 3. Quandl / Nasdaq Data Link (สำหรับดึง COT Report) - สมัครฟรีที่ https://data.nasdaq.com/sign-up
VITE_QUANDL_API_KEY=your_quandl_api_key_here

# App Config
VITE_APP_NAME=TradeSetup
VITE_APP_ENV=development
